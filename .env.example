# Copy this file to ".env" and fill it in. ".env" is in .gitignore: it is never committed.

# Garmin Connect Personal API key (Garmin Connect Web > Personal API Key).
# Same variable name the official Garmin client uses.
GARMIN_PERSONAL_API_KEY=

# Optional (defaults in parentheses)
# GARMIN_MCP_PORT=8000          (local server port)
# GARMIN_MCP_CACHE_TTL=300      (seconds a response is kept in memory; 0 = no cache)
