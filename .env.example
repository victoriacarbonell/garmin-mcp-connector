# Copy this file to ".env" and fill it in. ".env" is in .gitignore: it is never committed.

# --- Garmin ---------------------------------------------------------------
# Garmin Connect Personal API key (Garmin Connect Web > Personal API Key).
# Same variable name the official Garmin client uses.
GARMIN_PERSONAL_API_KEY=

# --- Authorization (required unless GARMIN_MCP_AUTH_DISABLED=1) -------------
# Where clients reach this server. Locally: http://localhost:8000
# On Azure: the https URL of the Container App, with no path.
GARMIN_MCP_PUBLIC_URL=http://localhost:8000

# Secret that signs every token. Changing it logs every client out.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GARMIN_MCP_SIGNING_KEY=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Its "Authorization callback URL" must be <GARMIN_MCP_PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric id of the ONLY GitHub account allowed in (not the username).
# Find yours at https://api.github.com/users/<your-username> ("id").
GITHUB_ALLOWED_USER_ID=

# --- Optional (defaults in parentheses) -------------------------------------
# GARMIN_MCP_HOST=127.0.0.1     (use 0.0.0.0 inside Docker)
# GARMIN_MCP_PORT=8000
# GARMIN_MCP_CACHE_TTL=300      (seconds a response is kept in memory; 0 = no cache)

# Local testing WITHOUT authorization. Only works on 127.0.0.1; the server
# refuses to start on any other host with this set.
# GARMIN_MCP_AUTH_DISABLED=1
